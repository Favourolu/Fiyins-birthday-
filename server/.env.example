# Copy this file to .env and change the values before deploying.

# Postgres connection string. Locally: a Postgres server you're running
# yourself. On Vercel: the value provided by your Postgres storage
# integration (usually exposed as POSTGRES_URL, which the app also accepts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fiyin_birthday

# Secret used to sign login session tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Admin dashboard credentials (separate from the participants' shared password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Set to "true" to let participants retake the test (off by default: one attempt each).
ALLOW_RETAKE=false

# Port the local API/server listens on (unused on Vercel).
PORT=4000

# Only needed if you run the client on a different origin than the server
# (e.g. client dev server on :5173 talking to the API on :4000).
# CLIENT_ORIGIN=http://localhost:5173
